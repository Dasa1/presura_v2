# Public Site Base URL (used for canonical/sitemaps)
PUBLIC_SITE_URL=https://example.com

# Sanity CMS config (Public keys only)
PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id_placeholder
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2026-06-10

# Supabase database config (Server-only keys)
SUPABASE_URL=https://your_supabase_project_placeholder.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_placeholder

# Resend email notifications config
RESEND_API_KEY=re_your_resend_api_key_placeholder
RESEND_FROM_EMAIL=service@example.com
INQUIRY_RECIPIENT_EMAIL=lead-notifications@example.com

# Cloudflare Turnstile anti-spam
PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key_placeholder
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_placeholder

# Privacy-friendly analytics
PUBLIC_ANALYTICS_DOMAIN=example.com
