---
import { AlertTriangle, Thermometer, Droplets } from '@lucide/astro';

interface Props {
  problem: {
    title: string;
    slug: { current: string };
    problemStatement: string;
    symptoms?: string[];
  };
  recommendedService?: {
    title: string;
    slug: { current: string };
  };
}

const { problem, recommendedService } = Astro.props;

// Image mapping with WebP demo assets
const getImageSrc = (slug: string) => {
  if (slug.includes('bojler')) {
    return '/demo-assets/demo-hero-ambience.webp';
  }
  return '/demo-assets/demo-technical-piping-ambience.webp';
};

const imageSrc = getImageSrc(problem.slug.current);
const iconType = problem.slug.current.includes('bojler') ? 'alert' : (problem.slug.current.includes('radijator') ? 'temp' : 'droplets');
---

<div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden flex flex-col justify-between card-hover interactive-transition relative">
  <!-- Top image band -->
  <div class="h-44 w-full overflow-hidden bg-slate-100 relative border-b border-slate-100">
    <img 
      src={imageSrc} 
      alt={`Demo placeholder: ${problem.title} dijagnostika`} 
      class="w-full h-full object-cover object-center"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/20 to-transparent"></div>
  </div>

  <div class="p-6 sm:p-8 flex-grow flex flex-col justify-between space-y-5">
    <div class="space-y-4">
      <div class="flex justify-between items-center">
        <!-- Consistent Icon Tile (Lucide) -->
        <div class="bg-orange-50 border border-orange-100 text-orange-600 rounded-xl p-3 inline-block shadow-xs">
          {iconType === 'alert' && <AlertTriangle class="h-6 w-6" />}
          {iconType === 'temp' && <Thermometer class="h-6 w-6" />}
          {iconType === 'droplets' && <Droplets class="h-6 w-6" />}
        </div>
        
        <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded text-[10px] font-bold uppercase tracking-wider bg-orange-50 text-orange-800 border border-orange-100 shadow-3xs">
          <AlertTriangle class="h-3 w-3 text-orange-600" />
          <span>Simptom kvara</span>
        </div>
      </div>

      <div class="space-y-2">
        <h3 class="text-xl font-bold text-slate-900 tracking-tight">{problem.title}</h3>
        <p class="text-sm text-slate-650 leading-relaxed line-clamp-3">{problem.problemStatement}</p>
      </div>
      
      {problem.symptoms && problem.symptoms.length > 0 && (
        <div class="space-y-2 pt-2 border-t border-slate-100">
          <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block">Mogući znakovi:</span>
          <ul class="space-y-1.5 text-xs text-slate-500">
            {problem.symptoms.slice(0, 3).map((sym) => (
              <li class="flex items-start gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-orange-500 mt-1.5 shrink-0"></span>
                <span class="text-slate-650 font-medium">{sym}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
      
      <div class="bg-slate-50 border border-slate-200/60 rounded-xl p-4 text-xs text-slate-600 leading-relaxed">
        <span class="font-bold text-slate-700 block mb-1 uppercase tracking-wide text-[10px]">Preporučeni korak:</span>
        Stručna provjera i pre-dijagnostički pregled radi točne detekcije uzroka i sprječavanja širenja kvara.
      </div>
    </div>
    
    <div class="mt-6 pt-4 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <a href={`/problemi/${problem.slug.current}`} class="text-sm font-bold text-slate-700 hover:text-orange-500 focus-visible:ring-2 focus-visible:ring-orange-500 rounded p-1 transition-colors">
        Analiza simptoma &rarr;
      </a>
      {recommendedService ? (
        <div class="text-xs text-slate-500">
          Usluga: <a href={`/usluge/${recommendedService.slug.current}`} class="underline font-bold text-slate-700 hover:text-orange-500 transition-colors">{recommendedService.title}</a>
        </div>
      ) : (
        <a href="/kontakt/" class="inline-flex items-center justify-center px-4 py-2 border border-slate-200 text-xs font-bold rounded-lg text-slate-700 hover:bg-slate-50 transition-colors">
          Pošalji upit
        </a>
      )}
    </div>
  </div>
</div>
