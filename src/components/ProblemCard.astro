---
interface Props {
  problem: {
    title: string;
    slug: { current: string };
    problemStatement: string;
    symptoms?: string[];
  };
  recommendedService?: {
    title: string;
    slug: { current: string };
  };
}

const { problem, recommendedService } = Astro.props;
---

<div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 flex flex-col justify-between hover:shadow-md transition-shadow">
  <div class="space-y-4">
    <div class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-red-50 text-red-700 border border-red-100">
      Simptom
    </div>
    <h3 class="text-xl font-bold text-slate-900">{problem.title}</h3>
    <p class="text-sm text-slate-600 line-clamp-3">{problem.problemStatement}</p>
    
    {problem.symptoms && problem.symptoms.length > 0 && (
      <ul class="text-xs text-slate-500 space-y-1 pl-4 list-disc">
        {problem.symptoms.slice(0, 3).map((sym) => (
          <li>{sym}</li>
        ))}
      </ul>
    )}
  </div>
  
  <div class="mt-6 pt-4 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <a href={`/problemi/${problem.slug.current}`} class="text-sm font-semibold text-orange-600 hover:text-orange-700 focus-visible:ring-2 focus-visible:ring-orange-500 rounded p-1">
      Detaljna analiza &rarr;
    </a>
    {recommendedService && (
      <div class="text-xs text-slate-500">
        Preporučeno: <a href={`/usluge/${recommendedService.slug.current}`} class="underline font-medium text-slate-700 hover:text-orange-600">{recommendedService.title}</a>
      </div>
    )}
  </div>
</div>
