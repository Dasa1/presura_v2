<!-- Sticky CTA wrapper shown on mobile only (below md breakpoint) -->
<div class="md:hidden fixed bottom-0 left-0 right-0 z-40 bg-slate-900 border-t border-slate-800 p-4 flex gap-4">
  <a 
    href="#" 
    aria-disabled="true"
    onclick="event.preventDefault();"
    class="flex-1 inline-flex items-center justify-center px-4 py-3 border border-transparent text-sm font-bold rounded-lg bg-orange-600/50 text-slate-300 cursor-not-allowed select-none focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-orange-500"
    role="button"
    aria-label="Nazovite servis (Onemogućeno - placeholder)"
  >
    Nazovite: PHONE_PLACEHOLDER
  </a>
  <a 
    href="/kontakt/" 
    class="inline-flex items-center justify-center px-4 py-3 border border-slate-700 text-sm font-bold rounded-lg text-slate-300 hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-orange-500"
    aria-label="Pošaljite upit"
  >
    Upit
  </a>
</div>
