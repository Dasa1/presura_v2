<!-- Sticky CTA wrapper shown on mobile only (below md breakpoint) -->
<div class="md:hidden fixed bottom-0 left-0 right-0 z-40 bg-slate-950/95 border-t border-slate-800/80 p-3 flex gap-3 shadow-lg">
  <a 
    href="#" 
    aria-disabled="true"
    onclick="event.preventDefault();"
    class="flex-1 inline-flex items-center justify-center px-3 py-2 border border-orange-500/20 text-xs font-bold rounded-lg bg-orange-600/20 text-orange-200 cursor-not-allowed select-none focus:outline-none min-h-[44px] interactive-transition"
    role="button"
    aria-label="Nazovite servis (Onemogućeno - placeholder)"
  >
    Poziv: PHONE_PLACEHOLDER
  </a>
  <a 
    href="/kontakt/" 
    class="inline-flex items-center justify-center px-4 py-2 border border-slate-750 text-xs font-bold rounded-lg text-slate-200 bg-slate-900 hover:bg-slate-850 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-orange-500 min-h-[44px] interactive-transition"
    aria-label="Pošaljite upit"
  >
    Upit
  </a>
</div>
