---
import Layout from '../layouts/Layout.astro';
import InquiryForm from '../components/InquiryForm.astro';
import seedData from '../sanity/seed.json';
import { Phone, Mail, MapPin, Clock, AlertCircle } from '@lucide/astro';

const siteSettings = seedData.siteSettings;
---

<Layout title="Kontakt | Pošaljite Upit" description="Kontaktirajte tehnički servis Presura za redovni pregled i održavanje sustava grijanja, bojlera i instalacija.">
  <div class="max-w-6xl mx-auto space-y-12 px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="text-center space-y-4 max-w-xl mx-auto">
      <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight sm:text-5xl">
        Kontakt
      </h1>
      <p class="text-lg text-slate-600 leading-relaxed">
        Pošaljite upit za ponudu ili nam se obratite za dodatne informacije o tehničkim uslugama.
      </p>
    </div>

    <!-- Contact Info Cards & Form Section -->
    <div class="grid gap-8 lg:grid-cols-12 items-start">
      <!-- Left side: Contact Placeholders -->
      <div class="space-y-6 lg:col-span-5">
        <div class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 space-y-6 shadow-sm">
          <h2 class="text-xl font-bold text-slate-900">Podaci za kontakt</h2>
          
          <div class="space-y-5">
            <!-- Telephone -->
            <div class="flex items-start gap-4">
              <div class="p-3 bg-orange-50 rounded-xl text-orange-600 shrink-0">
                <Phone class="h-6 w-6" />
              </div>
              <div class="space-y-0.5">
                <span class="block text-xs text-slate-400 font-bold uppercase tracking-wider">Telefon</span>
                <span class="text-base font-semibold text-slate-950">{siteSettings.phoneDisplay}</span>
                <span class="block text-[10px] text-slate-500 italic">Preporučeni način za informativne razgovore</span>
              </div>
            </div>

            <!-- Email -->
            <div class="flex items-start gap-4">
              <div class="p-3 bg-orange-50 rounded-xl text-orange-600 shrink-0">
                <Mail class="h-6 w-6" />
              </div>
              <div class="space-y-0.5">
                <span class="block text-xs text-slate-400 font-bold uppercase tracking-wider">E-mail</span>
                <span class="text-base font-semibold text-slate-950">{siteSettings.emailDisplay}</span>
              </div>
            </div>

            <!-- Address -->
            <div class="flex items-start gap-4">
              <div class="p-3 bg-orange-50 rounded-xl text-orange-600 shrink-0">
                <MapPin class="h-6 w-6" />
              </div>
              <div class="space-y-0.5">
                <span class="block text-xs text-slate-400 font-bold uppercase tracking-wider">Adresa</span>
                <span class="text-base font-semibold text-slate-950">{siteSettings.addressDisplay}</span>
              </div>
            </div>

            <!-- Working Hours -->
            <div class="flex items-start gap-4">
              <div class="p-3 bg-orange-50 rounded-xl text-orange-600 shrink-0">
                <Clock class="h-6 w-6" />
              </div>
              <div class="space-y-0.5">
                <span class="block text-xs text-slate-400 font-bold uppercase tracking-wider">Radno Vrijeme</span>
                <span class="text-base font-semibold text-slate-950">{siteSettings.openingHours}</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Demo warning notice banner -->
        <div class="bg-amber-50 border border-amber-200 rounded-2xl p-6 space-y-3 shadow-sm">
          <h3 class="font-bold text-amber-800 flex items-center gap-2 text-sm sm:text-base">
            <AlertCircle class="h-5 w-5 text-amber-600 shrink-0" />
            Stranica u demonstracijskom načinu rada
          </h3>
          <p class="text-xs sm:text-sm text-amber-700 leading-relaxed font-medium">
            Ovo je testna verzija web stranice tehničkog servisa Presura. Svi kontakt podaci i obrasci služe isključivo za vizualni prikaz i nisu povezani sa stvarnim sustavima niti primaju upite.
          </p>
        </div>
      </div>

      <!-- Right side: Inquiry Form Component -->
      <div class="lg:col-span-7">
        <InquiryForm />
      </div>
    </div>
  </div>
</Layout>
