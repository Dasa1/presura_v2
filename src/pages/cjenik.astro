---
import Layout from '../layouts/Layout.astro';
import { sanityClient } from '../sanity/client';
import seedData from '../sanity/seed.json';

const priceItems = await sanityClient.fetch('*[_type == "priceItem"]');

// Resolve siteSettings
const siteSettings = seedData.siteSettings;
---

<Layout title="Cjenik Usluga | Transparentne Cijene" description="Informativni cjenik za strojno ispiranje centralnog grijanja, servis plinskih bojlera i ostale tehničke instalacije.">
  <div class="space-y-12 max-w-5xl mx-auto">
    <!-- Header -->
    <div class="text-center space-y-4 max-w-2xl mx-auto">
      <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight sm:text-5xl">
        Cjenik Usluga
      </h1>
      <p class="text-lg text-slate-600 leading-relaxed">
        Informativne cijene prije konačne ponude. Konačna ponuda ovisi o opsegu radova.
      </p>
    </div>

    <!-- Pricing list / grids -->
    {priceItems.length === 0 ? (
      <div class="bg-white rounded-2xl p-12 text-center border border-slate-200">
        <h2 class="text-xl font-bold text-slate-900 mb-2">Cijena na upit</h2>
        <p class="text-slate-500 font-medium max-w-md mx-auto">
          Trenutno nemamo definiran fiksni cjenik. Svaki sustav je jedinstven, stoga nas slobodno kontaktirajte za besplatnu procjenu i ponudu.
        </p>
      </div>
    ) : (
      <div class="grid gap-6 md:grid-cols-2">
        {priceItems.map((item: any) => (
          <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-8 flex flex-col justify-between hover:shadow-md transition-shadow space-y-6 relative overflow-hidden">
            <!-- Top brand strip accent -->
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-orange-500"></div>
            
            <div class="space-y-4">
              <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-4 pb-3 border-b border-slate-100">
                <h2 class="text-lg font-bold text-slate-900 leading-tight">{item.title}</h2>
                <div class="text-left sm:text-right shrink-0">
                  <div class="text-xl font-extrabold text-orange-600 bg-orange-50/50 border border-orange-100 rounded px-2.5 py-1 inline-block sm:block shadow-3xs">
                    {item.priceType === 'from' && `Od ${item.fromPrice} ${item.currency}`}
                    {item.priceType === 'range' && `${item.rangeMin} - ${item.rangeMax} ${item.currency}`}
                    {item.priceType === 'quote-only' && 'Na upit'}
                  </div>
                  <span class="text-[10px] text-slate-400 font-semibold uppercase tracking-wider block mt-1">Informativna cijena</span>
                </div>
              </div>

              {item.includedItems && item.includedItems.length > 0 && (
                <div class="space-y-2 pt-1">
                  <h3 class="text-xs font-bold text-slate-500 uppercase tracking-wider">Obuhvaćene stavke:</h3>
                  <ul class="space-y-2 text-sm text-slate-600">
                    {item.includedItems.map((inc: string) => (
                      <li class="flex items-start gap-2">
                        <svg class="h-4 w-4 text-orange-500 shrink-0 mt-0.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                        </svg>
                        <span class="font-medium text-slate-650">{inc}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>

            {item.caveatText && (
              <div class="bg-slate-50 rounded-lg p-3.5 border-l-4 border-l-orange-500 border-y border-r border-slate-200/60 text-xs text-slate-600 leading-relaxed italic">
                <strong>Napomena:</strong> {item.caveatText}
              </div>
            )}
          </div>
        ))}
      </div>
    )}

    <!-- Global Caveat Disclaimer -->
    <div class="bg-slate-900 border border-slate-800 text-slate-200 rounded-2xl p-6 text-sm space-y-2.5 max-w-3xl mx-auto shadow-sm">
      <h3 class="font-bold flex items-center gap-2 text-white">
        <svg class="h-5 w-5 text-orange-500 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Napomena o cijenama i obračunu
      </h3>
      <p class="leading-relaxed text-xs sm:text-sm text-slate-350">
        Prikazane cijene su isključivo informativnog karaktera. Točna cijena usluge utvrđuje se nakon uviđaja stanja sustava, pregleda instalacija i specifikacije potrebnih rezervnih dijelova ili kemijskih sredstava. Sve cijene su podložne promjenama ovisno o složenosti radova.
      </p>
    </div>

    <!-- CTA -->
    <div class="bg-slate-900 text-white rounded-2xl p-8 sm:p-12 text-center space-y-6">
      <h2 class="text-2xl font-bold tracking-tight">Trebate točnu procjenu troška?</h2>
      <p class="text-slate-300 max-w-xl mx-auto text-sm sm:text-base">
        Naš stručni tim napravit će specifikaciju radova prilagođenu vašem objektu i sustavu centralnog grijanja.
      </p>
      <div class="flex flex-wrap justify-center gap-4 pt-2">
        <a href="/kontakt/" class="inline-flex items-center justify-center px-6 py-3 border border-transparent text-base font-bold rounded-lg bg-orange-500 text-white hover:bg-orange-600 focus:outline-none transition-colors shadow-md shadow-orange-500/10">
          Zatražite ponudu
        </a>
        <button
          type="button"
          aria-disabled="true"
          class="inline-flex items-center justify-center px-6 py-3 border border-slate-700 text-base font-bold rounded-lg text-slate-300 bg-slate-800/40 cursor-not-allowed select-none focus:outline-none min-h-[44px] hover:bg-slate-800/60"
        >
          Telefon: PHONE_PLACEHOLDER
        </button>
      </div>
    </div>
  </div>
</Layout>
