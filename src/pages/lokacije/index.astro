---
import Layout from '../../layouts/Layout.astro';
import { sanityClient } from '../../sanity/client';

const allLocations = await sanityClient.fetch('*[_type == "location"]');

// Filter out locations that do not have at least one unique proof block
const locations = allLocations.filter((l: any) => l.localProofBlocks && l.localProofBlocks.length > 0);
---

<Layout title="Lokacije Usluga | Gdje Radimo" description="Pogledajte popis gradova i općina u kojima nudimo servis bojlera i strojno ispiranje grijanja.">
  <div class="space-y-8">
    <div class="text-center max-w-xl mx-auto space-y-4">
      <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight sm:text-4xl">
        Lokacije i Područje Rada
      </h1>
      <p class="text-lg text-slate-600">
        Područje rada čeka vlasničku potvrdu. Lokalni dokazi i reference nisu još verificirani.
      </p>
    </div>

    {locations.length === 0 ? (
      <div class="bg-white rounded-lg p-12 text-center border border-slate-200">
        <p class="text-slate-500 font-medium">Trenutno nema dostupnih lokacija s verificiranim lokalnim radovima.</p>
      </div>
    ) : (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {locations.map((loc: any) => (
          <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden flex flex-col justify-between card-hover interactive-transition">
            <!-- Schematic abstract map visual top band -->
            <div class="h-32 w-full bg-slate-50 relative overflow-hidden border-b border-slate-100 flex items-center justify-center">
              <svg class="absolute inset-0 w-full h-full text-slate-200" preserveAspectRatio="none" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M0 20 H100 M0 50 H100 M0 80 H100 M20 0 V100 M50 0 V100 M80 0 V100" stroke="currentColor" stroke-width="0.5" stroke-dasharray="2 2" />
                <path d="M-10 30 C 30 10, 40 80, 110 70" stroke="currentColor" stroke-width="1.5" />
                <path d="M10 -10 C 20 40, 70 60, 90 110" stroke="currentColor" stroke-width="1.5" />
                <path d="M30 110 C 50 60, 80 40, 110 20" stroke="currentColor" stroke-width="1" />
                <circle cx="38" cy="23" r="1.5" fill="currentColor" />
                <circle cx="62" cy="45" r="2" fill="currentColor" />
                <circle cx="78" cy="74" r="1.5" fill="currentColor" />
                <circle cx="21" cy="65" r="1.5" fill="currentColor" />
              </svg>
              <!-- Floating central pin -->
              <div class="absolute p-2.5 bg-white rounded-full shadow-md border border-slate-100 text-orange-500 z-10">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
            </div>

            <div class="p-6 flex flex-col justify-between flex-grow space-y-4">
              <div class="space-y-2">
                <div class="inline-flex items-center gap-1 text-xs font-bold tracking-wider text-orange-650 uppercase">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <span>{loc.cityName}</span>
                </div>
                <h2 class="text-xl font-bold text-slate-900">{loc.cityName}</h2>
                <p class="text-sm text-slate-600">Područje rada čeka vlasničku potvrdu.</p>
              </div>
              
              <div class="pt-4 border-t border-slate-100 flex justify-between items-center gap-2">
                <a href={`/lokacije/${loc.slug.current}`} class="text-sm font-bold text-slate-700 hover:text-orange-500 transition-colors">
                  Prikaži detalje &rarr;
                </a>
                <span class="text-[10px] bg-slate-50 text-slate-500 px-2.5 py-0.5 rounded border border-slate-200 font-bold uppercase tracking-wider">
                  Čeka potvrdu
                </span>
              </div>
            </div>
          </div>
        ))}
      </div>
    )}
  </div>
</Layout>
