---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCTA from '../components/StickyCTA.astro';
import MetaTags from '../components/seo/MetaTags.astro';
import SchemaMarkup from '../components/seo/SchemaMarkup.astro';
import PrivacyAnalytics from '../components/analytics/PrivacyAnalytics.astro';

interface Props {
  title: string;
  description?: string;
  pageType?: 'home' | 'service' | 'problem' | 'location' | 'pricing' | 'faq';
  customSchemaData?: any;
}

const { 
  title, 
  description = 'Presura - Servis grijanja i tehničke usluge', 
  pageType = 'home',
  customSchemaData 
} = Astro.props;
---

<!doctype html>
<html lang="hr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- MetaTags helper -->
    <MetaTags title={title} description={description} />
    
    <!-- SchemaMarkup helper -->
    <SchemaMarkup pageType={pageType} customData={customSchemaData} />

    <!-- Privacy-friendly Analytics -->
    <PrivacyAnalytics />
  </head>
  <body class="flex flex-col min-h-screen">
    <!-- Accessibility: Skip to main content -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:p-4 focus:bg-orange-600 focus:text-white focus:rounded focus:outline-none">
      Preskoči na sadržaj
    </a>

    <!-- Global Header -->
    <Header />

    <!-- Main Content Slot -->
    <main id="main-content" class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 pb-24 md:pb-8 focus:outline-none" tabindex="-1">
      <slot />
    </main>

    <!-- Floating mobile CTA -->
    <StickyCTA />

    <!-- Global Footer -->
    <Footer />
  </body>
</html>
